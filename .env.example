# Optional: TV listings and search work without credentials through TVmaze.
# Get your own movie API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Alternatively, use the API Read Access Token (takes precedence over the API key).
TMDB_ACCESS_TOKEN=
# Optional secondary movie search: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
